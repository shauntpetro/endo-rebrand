# Canonical public origin — required to allow production indexing
# Set only after this exact HTTPS origin is connected and verified
NEXT_PUBLIC_SITE_URL=

# Publicly displayed recovery inbox — use only an approved, monitored mailbox
NEXT_PUBLIC_CONTACT_EMAIL=

# Email delivery (Resend) — all four values are required; forms fail closed
# Use plain mailbox addresses only (no "Display Name <address>" syntax)
RESEND_API_KEY=
FORM_FROM_EMAIL=
FORM_TO_EMAIL=

# Analytics (PostHog) — disabled if missing
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Error tracking (Sentry) — disabled if missing
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
